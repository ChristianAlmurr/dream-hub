#!/bin/sh
# Called by scripts/dream_finish.py and run-dream.sh with a title and a body (the store's name and counts only).
# Each new store gets a copy as <store>/notify.sh. This one shows a macOS notification. To be told elsewhere, replace
# the line below in your store's notify.sh (it is yours, and no sync overwrites it), for example with a push service:
#   curl -fsS -d "$2" -H "Title: $1" https://ntfy.sh/<your-private-topic>
# Remove the execute bit (chmod -x) to be told nothing.
command -v osascript >/dev/null 2>&1 || exit 0
exec osascript -e 'on run argv' -e 'display notification (item 2 of argv) with title (item 1 of argv)' -e 'end run' "$1" "$2"
